{
  "name": "anique",
  "version": "0.1.0",
  "description": "Anique \u2014 multi-domain CLI agent with Lens modes",
  "type": "module",
  "bin": {
    "anique": "./dist/index.js"
  },
  "files": [
    "dist",
    "lenses",
    "templates",
    "ANIQUE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "anique": "tsx --experimental-sqlite src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --experimental-sqlite scripts/smoke.ts",
    "e2e": "tsx --experimental-sqlite scripts/e2e-approval.ts",
    "e2e:web": "tsx --experimental-sqlite scripts/e2e-web.ts",
    "e2e:unlock": "tsx --experimental-sqlite scripts/e2e-unlock-flow.ts",
    "e2e:sudo": "tsx --experimental-sqlite scripts/e2e-sudo.ts",
    "e2e:hard": "tsx --experimental-sqlite scripts/e2e-hard.ts",
    "postbuild": "node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/index.js',0o755))\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "anique",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.31",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
